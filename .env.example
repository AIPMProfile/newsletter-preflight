# Copy to .env and fill in. .env is gitignored; .env.example is not.

# Gemini (default provider). Either name works; GEMINI_API_KEY wins.
GEMINI_API_KEY=

# --- optional overrides -------------------------------------------------
# PREFLIGHT_PROVIDER=gemini          # or: anthropic
# PREFLIGHT_MODEL=gemini-3.5-flash-lite  # ~2.0s, the default. gemini-3.7-flash:
#                                        # stronger but ~3.5s and 503s under load
# PREFLIGHT_THINKING_LEVEL=LOW       # LOW | MEDIUM | HIGH  (MINIMAL: flash-lite only)
# PREFLIGHT_LLM_BUDGET=6.0           # seconds for the intent reviewer
# PREFLIGHT_LLM_TIMEOUT=20.0         # seconds, used by `audit --deep`

# Free-tier keys are limited to 5 requests/minute per model, which `eval --live`
# (6 samples) will exceed. Use --no-llm, a paid key, or expect rate-limit rows.

# Only needed with PREFLIGHT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
